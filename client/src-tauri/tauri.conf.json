{
  "$schema": "https://schema.tauri.app/config/2.json",
  "productName": "JohnAi",
  "version": "0.1.0",
  "identifier": "com.johnai.widget",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8080"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "JohnAi Widget",
        "width": 550,
        "height": 450,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "infoPlist": {
        "NSMicrophoneUsageDescription": "JohnAi a besoin d'accéder au microphone pour enregistrer vos notes vocales et dicter vos pensées."
      }
    }
  }
}
