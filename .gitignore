# macOS
.DS_Store

# Node / NPM
node_modules/
client/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Rust / Tauri
client/src-tauri/target/
# gen/android's own nested .gitignore excludes build/, .gradle/, etc. — the
# generated Android/Kotlin *source* (AndroidManifest.xml and friends) is
# tracked like Info.plist is for macOS, since it needs manual native edits
# (e.g. RECORD_AUDIO permission) that `tauri android init` won't reapply.

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/

# Secrets
server/.env

# Local Data & DB
server/data/
server/uploads/

# Scratch screenshots for bug reports, not app content
bug/
