# Copy to server/.env and fill in real values. Never commit server/.env.

# Obligatoire : protège toutes les routes non publiques (X-API-Key header, ?api_key= pour le websocket).
API_KEY=

# Optionnel : active le mode cloud (Android / fallback sans modèle local).
GEMINI_API_KEY=

OLLAMA_URL=http://localhost:11434
GENERAL_MODEL=gemma3:12b
CODER_MODEL=qwen2.5-coder:14b

# Taille du modèle Whisper local (tiny/base/small/medium/large-v3). Plus gros = plus
# précis mais plus lent sur CPU. "small" est un bon compromis pour du français.
WHISPER_MODEL=small

# Optionnel : origines CORS autorisées, séparées par des virgules. "*" par défaut.
CORS_ORIGINS=*

# Obligatoire pour utiliser le serveur MCP (/mcp) : distinct de API_KEY (surface
# d'exposition différente — REST/websocket vs MCP). Bearer token à mettre dans
# la config du client MCP (Claude Code/Desktop/claude.ai), jamais commité.
MCP_API_KEY=

# Optionnel : anti-abus du endpoint MCP (token bucket). Défauts : rafales
# jusqu'à 30 appels, ~1 toutes les 2s en régime soutenu.
MCP_RATE_LIMIT_CAPACITY=30
MCP_RATE_LIMIT_REFILL_PER_SEC=0.5
